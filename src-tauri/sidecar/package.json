{
  "name": "f95-bridge",
  "version": "1.9.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prebuild:bundle": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "playwright install chromium --no-shell",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs --external:playwright",
    "build:sea": "node scripts/build-sea.mjs",
    "build:prune": "node scripts/prune-playwright-artifacts.mjs"
  },
  "dependencies": {
    "browser-rest-api": "file:../../../browser-api",
    "cheerio": "^1.2.0",
    "f95-app": "file:../..",
    "fast-xml-parser": "^5.12.1",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
